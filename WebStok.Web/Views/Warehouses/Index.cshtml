@model WebStok.Web.Models.WarehousePageViewModel

@{
    ViewData["Title"] = "Depolar";
}

<div class="mb-4">
    <h1>Depolar</h1>
    <p class="text-muted">
        Merkez, bölge ve üretim depolarını tanımlayın.
    </p>
</div>

@if (TempData["Success"] is string message)
{
    <div class="alert alert-success" role="alert">
        @message
    </div>
}

<div class="row g-4">
    <div class="col-lg-4">
        <div class="card">
            <div class="card-body">
                <h2 class="h5 mb-3">Depo ekle</h2>

                <form asp-controller="Warehouses"
                      asp-action="Create"
                      method="post"
                      asp-antiforgery="true">

                    <div asp-validation-summary="All"
                         class="text-danger"
                         role="alert"></div>

                    <div class="mb-3">
                        <label asp-for="Input.Code" class="form-label">
                            Depo kodu
                        </label>
                        <input asp-for="Input.Code"
                               class="form-control"
                               placeholder="MRK-01"
                               maxlength="30"
                               required />
                    </div>

                    <div class="mb-3">
                        <label asp-for="Input.Name" class="form-label">
                            Depo adı
                        </label>
                        <input asp-for="Input.Name"
                               class="form-control"
                               placeholder="Merkez Depo"
                               maxlength="150"
                               required />
                    </div>

                    <div class="mb-3">
                        <label asp-for="Input.Description"
                               class="form-label">
                            Açıklama
                        </label>
                        <textarea asp-for="Input.Description"
                                  class="form-control"
                                  rows="3"
                                  maxlength="500"></textarea>
                    </div>

                    <button type="submit" class="btn btn-primary">
                        Depo ekle
                    </button>
                </form>
            </div>
        </div>
    </div>

    <div class="col-lg-8">
        <div class="card">
            <div class="card-body">
                <h2 class="h5 mb-3">
                    Depo listesi (@Model.Warehouses.Count)
                </h2>

                @if (Model.Warehouses.Count == 0)
                {
                    <p class="text-muted mb-0">
                        Henüz depo tanımlanmadı.
                    </p>
                }
                else
                {
                    <div class="table-responsive">
                        <table class="table align-middle">
                            <thead>
                                <tr>
                                    <th scope="col">Kod</th>
                                    <th scope="col">Depo</th>
                                    <th scope="col">Durum</th>
                                </tr>
                            </thead>
                            <tbody>
                                @foreach (var warehouse in Model.Warehouses)
                                {
                                    <tr>
                                        <td>@warehouse.Code</td>
                                        <td>
                                            <div>@warehouse.Name</div>
                                            <small class="text-muted">
                                                @warehouse.Description
                                            </small>
                                        </td>
                                        <td>
                                            @if (warehouse.IsActive)
                                            {
                                                <span class="badge bg-success">
                                                    Aktif
                                                </span>
                                            }
                                            else
                                            {
                                                <span class="badge bg-secondary">
                                                    Pasif
                                                </span>
                                            }
                                        </td>
                                    </tr>
                                }
                            </tbody>
                        </table>
                    </div>
                }
            </div>
        </div>
    </div>
</div>