@model List<WebStok.Business.DTOs.StockBalanceDto>

@{
    ViewData["Title"] = "Stok Durumu";

    var productCount = Model
        .Select(x => x.ProductId)
        .Distinct()
        .Count();

    var criticalCount = Model
        .Where(x => x.IsCritical)
        .Select(x => new { x.WarehouseId, x.ProductId })
        .Distinct()
        .Count();
}

<div class="d-flex justify-content-between align-items-center mb-3">
    <div>
        <h1>Stok durumu</h1>
        <p class="text-muted mb-0">
            Depo ve lot bazında, hareketlerden hesaplanan bakiyeler.
        </p>
    </div>

    <a asp-controller="StockReceipts"
       asp-action="Index"
       class="btn btn-primary">
        Mal kabul
    </a>
</div>

<div class="row g-3 mb-4">
    <div class="col-md-6">
        <div class="card">
            <div class="card-body">
                <div class="text-muted">Hareket görmüş ürün</div>
                <strong class="fs-3">@productCount</strong>
            </div>
        </div>
    </div>

    <div class="col-md-6">
        <div class="card">
            <div class="card-body">
                <div class="text-muted">
                    Kritik seviyedeki ürün–depo sayısı
                </div>
                <strong class="fs-3 text-danger">@criticalCount</strong>
            </div>
        </div>
    </div>
</div>

@if (Model.Count == 0)
{
    <div class="alert alert-info">
        Erişebildiğiniz depolarda henüz stok hareketi yok.
    </div>
}
else
{
    <div class="card">
        <div class="card-body">
            <div class="table-responsive">
                <table class="table align-middle">
                    <thead>
                        <tr>
                            <th scope="col">Depo</th>
                            <th scope="col">Ürün</th>
                            <th scope="col">Lot</th>
                            <th scope="col">Lot bakiyesi</th>
                            <th scope="col">SKT</th>
                            <th scope="col">Garanti bitişi</th>
                            <th scope="col">Depodaki ürün toplamı</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var row in Model)
                        {
                            <tr>
                                <td>@row.WarehouseName</td>
                                <td>
                                    <strong>@row.ProductName</strong>
                                    <div class="text-muted">
                                        @row.ProductCode
                                    </div>
                                </td>
                                <td>@row.LotNumber</td>
                                <td>
                                    @row.Quantity.ToString("0.###")
                                    @row.Unit
                                </td>
                                <td>
                                    @(row.ExpiryDate?.ToString("dd.MM.yyyy") ?? "—")
                                </td>
                                <td>
                                    @(row.WarrantyEndDate?.ToString("dd.MM.yyyy") ?? "—")
                                </td>
                                <td>
                                    <div>
                                        @row.WarehouseProductQuantity.ToString("0.###")
                                        @row.Unit
                                    </div>
                                    <small class="text-muted">
                                        Minimum:
                                        @row.MinimumStockLevel.ToString("0.###")
                                        @row.Unit
                                    </small>
                                    @if (row.IsCritical)
                                    {
                                        <div>
                                            <span class="badge bg-danger">
                                                Kritik stok
                                            </span>
                                        </div>
                                    }
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        </div>
    </div>
}